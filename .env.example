# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Game server (Run-a-farm-backend) for local dev / non-Bloxity hosting. Dev builds default to ws://localhost:2567.
# VITE_SERVER_URL=ws://localhost:2567

# GameAnalytics (src/analytics.js). Unset = analytics off. Deploys set these from the repo secrets
# GA_GAME_KEY / GA_SECRET_KEY for the prod build only. Use a separate test game's keys here if you
# want to see local events in GameAnalytics (Realtime tab) without mixing them into the real data.
# VITE_GA_GAME_KEY=
# VITE_GA_SECRET_KEY=
